# Copy to `.env.local` for `next dev`. Never commit real secrets.

POSTGRES_URL=
WOOCOMMERCE_WEBHOOK_SECRET=
GHL_WEBHOOK_SECRET=
# SketchUp CAD ingest HMAC (header: X-CCPatio-Signature)
SKETCHUP_WEBHOOK_SECRET=
KATANA_API_KEY=
# Preferred Katana auth name (falls back to KATANA_API_KEY when unset)
KATANA_PERSONAL_ACCESS_TOKEN=
# Inngest — event send key and/or signing key (required for serve + cron)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_REST_API_TOKEN=

# Crawl / Walk / Run gate — default log (no Katana SO/MTO POSTs)
ORDER_PIPELINE_MODE=log

# Oh-Crap ops alerts (Phase 5 token-rot + saga onFailure)
# Daily system.health.ping emails this address on Katana/Woo/Clover 401/403
OH_CRAP_ADMIN_EMAIL=
OH_CRAP_FROM_EMAIL=
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage (PIM product images). Service role is server-only — never NEXT_PUBLIC_.
# Anon key enables Realtime multi-browser sync on /admin/dictionary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must stay false until Phase 1 Katana sandbox is signed off.
DOWNSTREAM_MUTATIONS=false

# WooCommerce catalog REST (master-data fan-out — not order webhooks)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Clover Inventory (POS catalog fan-out)
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=

# Isolated POST /api/sandbox/katana-mto-test (not Woo/GHL). Unset = route refuses all calls.
SANDBOX_KATANA_MTO_SECRET=

# VividWorks ops sheet sync (scripts/vividworks/06-sync-google-sheets.ts)
# Spreadsheet ID or full https://docs.google.com/spreadsheets/d/<ID>/edit URL
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Katana SKU
# Service account JSON path (share the sheet with the account's client_email)
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatives if you prefer env vars over a key file:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
