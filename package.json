{
  "name": "ccpatio-middleware",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "qa:clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true}); fs.rmSync('node_modules/.cache', {recursive:true, force:true});\"",
    "qa:phase1-build": "npm run qa:clean && tsc --noEmit && npx cross-env NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production next build",
    "qa:phase2-db": "tsx scripts/qa/proof-of-life.runner.ts",
    "qa:lifecycle": "npm run qa:phase1-build && npm run qa:phase2-db",
    "dev:pim": "next dev -p 3000",
    "dev:sandbox": "npm run dev --prefix 3d-sandbox",
    "dev": "concurrently -c \"cyan,magenta\" -n \"PIM,3D\" \"npm run dev:pim\" \"npm run dev:sandbox\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-sku-mappings.ts",
    "db:scrape-katana": "tsx scripts/scrape-katana.ts",
    "katana:pull": "tsx scripts/katana-live-pull.ts",
    "katana:gap-analysis": "tsx scripts/analyze-katana-gap.ts",
    "db:seed-katana-bulk": "tsx scripts/seed-katana-bulk-materials.ts",
    "db:seed-ocean-sa": "tsx scripts/seed-ocean-subassemblies.ts",
    "db:seed-ocean-bom": "tsx scripts/seed-ocean-bom.ts",
    "db:sync-materials": "tsx scripts/sync-all-materials.ts",
    "db:seed-bra-bro": "tsx scripts/seed-remaining-collections.ts",
    "db:seed-bra-bro:dry": "tsx scripts/seed-remaining-collections.ts --dry-run",
    "db:audit-bra-bro": "tsx scripts/audit-collection-bom.ts",
    "db:seed-missing-fgs": "tsx scripts/seed-missing-fgs.ts",
    "db:seed-missing-fgs:dry": "tsx scripts/seed-missing-fgs.ts --dry-run",
    "db:sync-all-boms": "tsx scripts/sync-all-boms-to-katana.ts",
    "db:sync-all-boms:live": "tsx scripts/sync-all-boms-to-katana.ts --live",
    "db:rename-cabana-daybed": "tsx scripts/rename-cabana-daybed-sku.ts",
    "db:rename-cabana-daybed:dry": "tsx scripts/rename-cabana-daybed-sku.ts --dry-run",
    "katana:resolve-gaps": "tsx scripts/resolve-factory-gaps.ts",
    "katana:resolve-gaps:dry": "tsx scripts/resolve-factory-gaps.ts --dry-run",
    "katana:sanitize": "tsx scripts/sanitize-katana-catalog.ts",
    "katana:sanitize:dry": "tsx scripts/sanitize-katana-catalog.ts --dry-run",
    "db:backfill-katana": "tsx scripts/backfill-katana-ids.ts",
    "db:backfill-attributes": "tsx scripts/backfill-attributes.ts",
    "db:backfill-attributes:dry": "tsx scripts/backfill-attributes.ts --dry-run",
    "db:import-images": "tsx scripts/import-sheet-images.ts",
    "db:migrate-finished-skus": "tsx scripts/migrate-finished-good-skus.ts",
    "db:migrate-finished-skus:dry": "tsx scripts/migrate-finished-good-skus.ts --dry-run",
    "sku:generate": "python generate_sku_dictionary.py",
    "sku:export-review": "python export_sku_review.py",
    "scrape:sunbrella": "node scripts/scrape_sunbrella.js",
    "scrape:sunbrella:seed": "node scripts/scrape_sunbrella.js --mode=seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.3",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "driver.js": "^1.8.0",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "framer-motion": "^13.1.1",
    "gantt-task-react": "^0.3.9",
    "html2canvas": "^1.4.1",
    "inngest": "^4.18.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "next": "16.3.2",
    "postcss": "^8.5.26",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-zoom-pan-pinch": "^4.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
